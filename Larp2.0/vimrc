set nocompatible
syntax enable
filetype plugin indent on

set number
set showmode
set ruler

set tabstop=4
set shiftwidth=4
set softtabstop=4

set nowrap
set scrolloff=5
set sidescrolloff=5

set incsearch
set termguicolors

#bleck
highlight clear
if exists("syntax_on")
  syntax reset
endif

let g:colors_name = "amoled"

highlight Normal       guifg=#e0e0e0 guibg=#000000
highlight NonText      guifg=#333333 guibg=#000000
highlight CursorLine   guibg=#121212
highlight ColorColumn  guibg=#121212
highlight LineNr       guifg=#4b5563 guibg=#000000
highlight CursorLineNr guifg=#a855f7 guibg=#000000
highlight Visual       guibg=#262626
highlight Search       guifg=#000000 guibg=#eab308
highlight Comment      guifg=#6b7280 gui=italic
highlight Constant     guifg=#22d3ee
highlight Keyword      guifg=#a855f7 gui=bold
highlight Statement    guifg=#ef4444
highlight Function     guifg=#60a5fa
highlight Type         guifg=#4ade80
