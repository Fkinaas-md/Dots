bindsym Mod4+e exec nautilus &



xwayland enable

# xyz screenshot idk 
bindsym Mod4+p exec grim -g "$(slurp)" - | wl-copy --type image/png
#fullscreen screenshot
bindsym Mod4+o exec grim - | wl-copy --type image/png

